{
    "compilerOptions": {
      "target": "es5",
      "module": "esnext",
      "lib": ["dom", "esnext"],
      "jsx": "react",
      "strict": true,
      "esModuleInterop": true,
      "allowJs": true,
      "skipLibCheck": true,
      "forceConsistentCasingInFileNames": true,
      "declaration": false,
      "outDir": "./dist",
      "sourceMap": true,
      "moduleResolution": "node",
      "noImplicitAny": false,
    },
    "include": ["src"],
    "exclude": ["node_modules", "dist"]
}